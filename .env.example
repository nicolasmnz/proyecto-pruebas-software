# ============================================
# Application
# ============================================

NODE_ENV=development

# ============================================
# Backend - Express
# ============================================

API_PORT=3000

# Origen permitido para CORS
CORS_ORIGIN=http://localhost:5173

# ============================================
# Frontend - Vite
# ============================================

VITE_API_URL=http://localhost:3000/api

# ============================================
# PostgreSQL
# ============================================

POSTGRES_DB=proyecto_pruebas
POSTGRES_USER=proyecto_user
POSTGRES_PASSWORD=proyecto_password

POSTGRES_PORT=5432

# ============================================
# Database connection - API
# ============================================

DB_HOST=db
DB_PORT=5432
DB_NAME=proyecto_pruebas
DB_USER=proyecto_user
DB_PASSWORD=proyecto_password

DATABASE_URL=postgresql://proyecto_user:proyecto_password@db:5432/proyecto_pruebas